# Mnemosyne — example environment configuration.
# Copy to `.env` and fill in real values. Every MNEMOSYNE_* var below is
# optional except MNEMOSYNE_PG_DSN (required by the default startup checks).

# --- Database (required) ---
MNEMOSYNE_PG_DSN=postgresql://mnemosyne:mnemosyne@localhost:5432/mnemosyne

# Postgres connection-pool tuning
MNEMOSYNE_PG_POOL_MIN_SIZE=2
MNEMOSYNE_PG_POOL_MAX_SIZE=10
MNEMOSYNE_PG_COMMAND_TIMEOUT_S=60

# --- LLM ---
MNEMOSYNE_LLM_PROVIDER=ollama
MNEMOSYNE_LLM_MODEL=gemma3:4b
MNEMOSYNE_LLM_BASE_URL=http://localhost:11434/v1
MNEMOSYNE_LLM_API_KEY=
MNEMOSYNE_LLM_TIMEOUT_S=60
MNEMOSYNE_LLM_MAX_RETRIES=3

# --- Embedding ---
MNEMOSYNE_EMBEDDING_PROVIDER=ollama
MNEMOSYNE_EMBEDDING_MODEL=nomic-embed-text
MNEMOSYNE_EMBEDDING_BASE_URL=http://localhost:11434
MNEMOSYNE_EMBEDDING_API_KEY=
MNEMOSYNE_EMBEDDING_DIM=768
MNEMOSYNE_EMBEDDING_TIMEOUT_S=30
MNEMOSYNE_EMBEDDING_MAX_RETRIES=3

# --- Context / retrieval ---
MNEMOSYNE_DEFAULT_TOKEN_BUDGET=2000
MNEMOSYNE_TOKEN_ENCODING=cl100k_base
MNEMOSYNE_FTS_LANGUAGE=english

# --- Extraction / routing ---
MNEMOSYNE_EXTRACTION_VERSION=0.1.0
MNEMOSYNE_ROUTER_UNSTRUCTURED_THRESHOLD=0.7
MNEMOSYNE_ROUTER_YIELD_THRESHOLD=0.3

# --- Background worker ---
MNEMOSYNE_WORKER_POLL_INTERVAL_S=10
MNEMOSYNE_MAINTENANCE_INTERVAL_S=86400
MNEMOSYNE_PROCESSING_VISIBILITY_TIMEOUT_S=600

# --- Failure isolation ---
# 1 = memory failures never break the host agent (default); 0 = surface errors.
MNEMOSYNE_MEMORY_FAIL_OPEN=1

# --- save_memory tool ---
MNEMOSYNE_SAVE_MEMORY_CONTENT_CAP=10000

# --- Operational toggles (consumed outside Settings) ---
# 1 = startup checks warn only instead of raising.
MNEMOSYNE_STARTUP_WARN_ONLY=0
# 0 disables the Prometheus exporter.
MNEMOSYNE_METRICS_ENABLED=1
MNEMOSYNE_METRICS_ADDR=0.0.0.0
MNEMOSYNE_METRICS_PORT=9090
# 1 = buffer session turns in Postgres instead of in-process.
MNEMOSYNE_SESSION_PERSIST=0
